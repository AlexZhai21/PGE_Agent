{
  "$defs": {
    "Comparable": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "hours": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hours"
        },
        "similarity": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Similarity"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "basis": {
          "enum": [
            "actual",
            "benchmark",
            "synthetic"
          ],
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "rationale",
        "basis"
      ],
      "title": "Comparable",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
